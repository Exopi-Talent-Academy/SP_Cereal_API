<Application x:Class="Cereal_API.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cereal_API.WPF"
             xmlns:views="clr-namespace:Cereal_API.WPF.Views"
             xmlns:vm="clr-namespace:Cereal_API.WPF.ViewModels"
             xmlns:converters="clr-namespace:Cereal_API.WPF.Converters">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CerealDataTableViewModel}">
            <views:CerealDataTableView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ColumnHeaderViewModel}">
            <views:ColumnHeaderView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ColumnFilterViewModel}">
            <views:ColumnFilterView/>
        </DataTemplate>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style TargetType="Button">
            <!--
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="16"/>
            -->
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="DarkGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Gray"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
