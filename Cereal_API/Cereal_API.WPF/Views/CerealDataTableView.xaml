<UserControl x:Class="Cereal_API.WPF.Views.CerealDataTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Cereal_API.WPF.Views"
             xmlns:shared="clr-namespace:Cereal_API.Shared;assembly=Cereal_API.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="500">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal">

            <Button Content="Add Cereal"
                    Command="{Binding AddCerealCommand}"
                    Visibility="{Binding CanModifyTable, Converter={StaticResource BoolToVisibility}}"/>

            <Button Content="Load Cereals" 
                    Command="{Binding LoadCerealsCommand}"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"/>

        </StackPanel>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding FilteredCereals}"
                  SelectedItem="{Binding SelectedCereal, Mode=TwoWay}"
                  Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisibility}}"
                  IsReadOnly="{Binding CanModifyTable, Converter={StaticResource InverseBooleanConverter}}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AddingNewItem="DataGrid_AddingNewItem"
                  HorizontalAlignment="Left"
                  Margin="2">
            
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" 
                                    IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.IdColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Image" 
                                   Style="{StaticResource DataGridColumnHeaderTextBlock}"/>
                    </DataGridTemplateColumn.Header>
                    
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Image}"
                                   Width="50"
                                   Height="50"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Binding="{Binding Name}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.NameColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridComboBoxColumn SelectedValueBinding="{Binding Manufacturer}" 
                                        ItemsSource="{Binding Source={x:Static shared:EnumProvider.Manufacturers}}">
                    <DataGridComboBoxColumn.Header>
                        <ContentControl Content="{Binding DataContext.ManufacturerColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridComboBoxColumn.Header>
                </DataGridComboBoxColumn>

                <DataGridComboBoxColumn SelectedValueBinding="{Binding Type}" 
                                        ItemsSource="{Binding Source={x:Static shared:EnumProvider.Types}}">
                    <DataGridComboBoxColumn.Header>
                        <ContentControl Content="{Binding DataContext.TypeColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridComboBoxColumn.Header>
                </DataGridComboBoxColumn>

                <DataGridTextColumn Binding="{Binding Calories}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.CaloriesColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Protein}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.ProteinColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Fat}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.FatColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Sodium}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.SodiumColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Fiber}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.FiberColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Carbo}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.CarboColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Sugars}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.SugarsColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Potass}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.PotassColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Vitamins}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.VitaminsColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Shelf}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.ShelfColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Weight}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.WeightColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Cups}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.CupsColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Rating}">
                    <DataGridTextColumn.Header>
                        <ContentControl Content="{Binding DataContext.RatingColumn, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Actions"
                                   Style="{StaticResource DataGridColumnHeaderTextBlock}"/>
                    </DataGridTemplateColumn.Header>
                    
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding DataContext.IsLoggedIn, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}"
                                        VerticalAlignment="Top">

                                <Button Content="Save" 
                                        Command="{Binding DataContext.SaveNewCerealCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding ShowSave, Converter={StaticResource BoolToVisibility}}"/>

                                <Button Content="Cancel" 
                                        Command="{Binding DataContext.CancelNewCerealCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Visibility="{Binding ShowSave, Converter={StaticResource BoolToVisibility}}"/>

                                <Button Content="Update" 
                                        Command="{Binding DataContext.UpdateModifiedCerealCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVisibility}}"/>

                                <Button Content="Cancel" 
                                        Command="{Binding DataContext.CancelModifiedCerealCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVisibility}}"/>

                                <Button Content="Delete"
                                        Command="{Binding DataContext.DeleteCerealCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding ShowDelete, Converter={StaticResource BoolToVisibility}}"/>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
