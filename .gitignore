## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Bb]in/
[Oo]bj/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# VS Code
.vscode/

# Test Results
TestResults/
*.trx

# NuGet
packages/
*.nupkg

# Logs
*.log

# Publish output
publish/

# Entity Framework
*.db-wal
*.db-shm

# SQLite
# Ignore the database if it's only local development.
# Comment this out if your project ships with a seeded database.
*.db

# Windows
Thumbs.db
Desktop.ini

# Mac
.DS_Store

# Generated files
Generated/